[Unit]
Description=Zinger experiment bot (zinger.kierkegaard.space)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/david/Zinger
Environment=PORT=3000
Environment=ZINGER_INSTANCE=experiment
Environment=ZINGER_DATA_DIR=/home/david/Zinger/data
EnvironmentFile=-/home/david/Zinger/.env
ExecStart=/home/david/.local/share/fnm/node-versions/v22.22.3/installation/bin/node /home/david/Zinger/index.js
Restart=always
RestartSec=5
StandardOutput=append:/tmp/zinger-experiment.log
StandardError=append:/tmp/zinger-experiment.log

[Install]
WantedBy=default.target
